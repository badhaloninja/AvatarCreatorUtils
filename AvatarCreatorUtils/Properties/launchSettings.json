{
  "profiles": {
    "Launch Mod": {
      "commandName": "Executable",
      "executablePath": "$(AppPath)$(AppName).exe",
      "commandLineArgs": "-LoadAssembly \"Libraries/$(AppName)ModLoader.dll\" -Screen -Invisible -DoNotAutoLoadHome -SkipIntroTutorial -NeverSaveSettings -NeverSaveDash",
      "workingDirectory": "$(AppPath)"
    },
    "Launch Mod in VR": {
      "commandName": "Executable",
      "executablePath": "$(AppPath)$(AppName).exe",
      "commandLineArgs": "-LoadAssembly \"Libraries/$(AppName)ModLoader.dll\" -Invisible -DoNotAutoLoadHome -SkipIntroTutorial -NeverSaveSettings -NeverSaveDash",
      "workingDirectory": "$(AppPath)"
    }
  }
}